# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Salesforce OAuth 2.0 Configuration for Admin Authentication
# Consumer Key / Client ID from Salesforce Connected App or External Client App
SALESFORCE_CLIENT_ID=

# Consumer Secret / Client Secret from Salesforce Connected App or External Client App
SALESFORCE_CLIENT_SECRET=

# Salesforce Login URL (e.g., https://login.salesforce.com for production/dev or https://test.salesforce.com for sandbox/scratch orgs or My Domain)
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Explicit Redirect URI (Optional, if omitted defaults to ${APP_URL}/auth/salesforce/callback)
SALESFORCE_REDIRECT_URI=

# Authorized Salesforce Administrators (Comma-separated list of Salesforce Usernames, User IDs (005...), or Email addresses)
# Example: Dhole288@gmail.com, admin@royalchai.com, 005xx000001Sv4FAAS
SALESFORCE_ALLOWED_ADMINS=

# Secret key used for signing session cookies
SESSION_SECRET=
